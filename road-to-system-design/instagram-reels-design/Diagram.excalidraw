      "updated": 1780066239423,
      "link": null,
      "locked": false,
      "text": "Instagram never counts likes in real time. It queues events → batches them → caches the result. You're almost never seeing the exact live count — you're seeing the last cached value. And that's totally fine.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Instagram never counts likes in real time. It queues events → batches them → caches the result. You're almost never seeing the exact live count — you're seeing the last cached value. And that's totally fine.",
      "autoResize": true,
      "lineHeight": 1.25
    }
